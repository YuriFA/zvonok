{
  "name": "webrtc-chat",
  "private": true,
  "version": "0.5.0",
  "scripts": {
    "dev": "pnpm --stream -r run dev",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "clean": "rm -rf .parcel-cache && pnpm -r run clean",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "lint:ts": "pnpm -r run lint:ts",
    "test": "pnpm test:client && pnpm test:package && pnpm test:server && pnpm -C apps/server test:e2e",
    "test:client": "pnpm -C apps/client test:run",
    "test:package": "pnpm -r --filter \"./packages/*\" test:run",
    "test:server": "pnpm -C apps/server test",
    "release": "release-it",
    "release:ci": "release-it --ci",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "openspec:validate": "openspec validate --all"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "mediasoup",
      "@prisma/engines",
      "prisma",
      "@nestjs/core",
      "esbuild",
      "@tailwindcss/oxide",
      "lefthook",
      "unrs-resolver",
      "@scarf/scarf"
    ],
    "packageExtensions": {
      "@hookform/resolvers@*": {
        "peerDependencies": {
          "zod": "*"
        },
        "peerDependenciesMeta": {
          "zod": {
            "optional": true
          }
        }
      }
    }
  },
  "packageManager": "pnpm@10.28.1",
  "devDependencies": {
    "@fission-ai/openspec": "^1.12.0",
    "@release-it/conventional-changelog": "^10.0.6",
    "lefthook": "^2.1.12",
    "release-it": "^19.2.4",
    "vitepress": "^1.6.4"
  }
}
