# ZvonOK production environment template.
# Copy to .env and fill in every required value:  cp .env.production.example .env
# Full variable reference: docs/deployment.md

# --- Deployment -----------------------------------------------------------
# GitHub repository for pre-built GHCR images (required by docker-compose.prod.yml)
GHCR_REPO=user/zvonok
# IMAGE_TAG=latest

# --- Domain & Caddy --------------------------------------------------------
SITE_ADDRESS=chat.example.com
CLIENT_URL=https://chat.example.com

# --- Database ----------------------------------------------------------------
POSTGRES_USER=zvonok_admin
POSTGRES_PASSWORD=change-me-strong-random
POSTGRES_DB=zvonok

# --- Admin seed (optional; admin user created by the migrate job) -----------
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# --- Developer seed (optional; console account + project; API key printed once) ---
# DEV_SEED_USERNAME=
# DEV_SEED_PASSWORD=
# DEV_SEED_PROJECT=default

# --- JWT secrets (generate with: openssl rand -hex 64) ----------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN_MINUTES=15
JWT_REFRESH_EXPIRES_IN_DAYS=7
# Developer platform: console sessions, /v1 room tokens, approved guests
# (secrets must all differ)
JWT_DEV_SECRET=
JWT_ROOM_SECRET=
JWT_GUEST_SECRET=
ROOM_TOKEN_TTL_MINUTES=60

# --- mediasoup ---------------------------------------------------------------
MEDIASOUP_LISTEN_IP=0.0.0.0
# REQUIRED: server public IPv4 - media does not flow without it
MEDIASOUP_ANNOUNCED_IP=203.0.113.42
RTC_MIN_PORT=40000
RTC_MAX_PORT=40499

# --- TURN / coturn (generate secret with: openssl rand -base64 32) -----------
TURN_AUTH_SECRET=
TURN_EXTERNAL_IP=203.0.113.42
TURN_URL=turn:203.0.113.42:3478
TURNS_URL=turns:203.0.113.42:5349

# --- Egress (HLS/RTMP + recordings; stored on the egress_data volume) --------
# EGRESS_MEDIA_PORT_MIN=42000
# EGRESS_MEDIA_PORT_MAX=42100
# EGRESS_HLS_DIR=/data/egress-hls
# EGRESS_RECORDINGS_DIR=/data/egress-recordings
