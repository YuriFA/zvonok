{
  "name": "@zvonok/whiteboard-core",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuriFA/zvonOK.git",
    "directory": "packages/whiteboard-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./engine": {
      "types": "./src/engine.ts",
      "default": "./src/engine.ts"
    },
    "./protocol": {
      "types": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    },
    "./transport": {
      "types": "./src/transport.ts",
      "default": "./src/transport.ts"
    },
    "./yjs-room": {
      "types": "./src/yjs-room.ts",
      "default": "./src/yjs-room.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      "./engine": {
        "types": "./dist/engine.d.ts",
        "default": "./dist/engine.js"
      },
      "./protocol": {
        "types": "./dist/protocol.d.ts",
        "default": "./dist/protocol.js"
      },
      "./transport": {
        "types": "./dist/transport.d.ts",
        "default": "./dist/transport.js"
      },
      "./yjs-room": {
        "types": "./dist/yjs-room.d.ts",
        "default": "./dist/yjs-room.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:run": "vitest run",
    "lint:ts": "tsc --noEmit",
    "prepack": "pnpm run build",
    "lint": "oxlint . && pnpm fmt:check",
    "lint:fix": "oxlint . --fix && pnpm fmt",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "typescript": "~5.8.3",
    "vitest": "^4.0.18"
  }
}
