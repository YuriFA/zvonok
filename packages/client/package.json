        "default": "./dist/sfu/quality-score.js"
      },
      "./sfu/types": {
        "types": "./dist/sfu/types.d.ts",
        "default": "./dist/sfu/types.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:run": "vitest run",
    "lint:ts": "tsc --noEmit",
    "prepack": "pnpm run build",
    "lint": "oxlint . && pnpm fmt:check",
    "lint:fix": "oxlint . --fix && pnpm fmt",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "mediasoup-client": "^3.18.7",
