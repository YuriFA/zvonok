    },
    "./audio/audio-level-sampler": {
      "types": "./src/audio/audio-level-sampler.ts",
      "default": "./src/audio/audio-level-sampler.ts"
    },
    "./audio/remote-audio-mixer": {
      "types": "./src/audio/remote-audio-mixer.ts",
      "default": "./src/audio/remote-audio-mixer.ts"
    },
    "./helpers/concurrency": {
      "types": "./src/helpers/concurrency.ts",
      "default": "./src/helpers/concurrency.ts"
    },
    "./media/capture-state": {
      "types": "./src/media/capture-state.ts",
      "default": "./src/media/capture-state.ts"
    },
    "./media/interfaces": {
      "types": "./src/media/interfaces.ts",
      "default": "./src/media/interfaces.ts"
    },
