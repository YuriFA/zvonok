    "jsdom": "^28.1.0",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.1.6",
    "vitest": "^4.0.18"
  }
