      "./audio/audio-level-sampler": {
        "types": "./dist/audio/audio-level-sampler.d.ts",
        "default": "./dist/audio/audio-level-sampler.js"
      },
      "./audio/remote-audio-mixer": {
        "types": "./dist/audio/remote-audio-mixer.d.ts",
        "default": "./dist/audio/remote-audio-mixer.js"
      },
