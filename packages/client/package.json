        "types": "./dist/helpers/concurrency.d.ts",
        "default": "./dist/helpers/concurrency.js"
      },
      "./media/capture-state": {
        "types": "./dist/media/capture-state.d.ts",
        "default": "./dist/media/capture-state.js"
      },
      "./media/interfaces": {
        "types": "./dist/media/interfaces.d.ts",
        "default": "./dist/media/interfaces.js"
      },
      "./media/manager-factory": {
        "types": "./dist/media/manager-factory.d.ts",
        "default": "./dist/media/manager-factory.js"
      },
      "./screen-share/service": {
