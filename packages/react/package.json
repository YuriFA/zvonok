{
  "name": "@zvonok/react",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuriFA/zvonOK.git",
    "directory": "packages/react"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./embedded": {
      "types": "./src/embedded/ZvonokEmbeddedRoom.tsx",
      "default": "./src/embedded/ZvonokEmbeddedRoom.tsx"
    },
    "./css/component-kit.css": "./src/css/component-kit.css",
    "./css/embedded.css": "./src/css/embedded.css"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./embedded": {
        "types": "./dist/embedded/ZvonokEmbeddedRoom.d.ts",
        "default": "./dist/embedded/ZvonokEmbeddedRoom.js"
      },
      "./css/component-kit.css": "./dist/css/component-kit.css",
      "./css/embedded.css": "./dist/css/embedded.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/css && cp -R src/css/. dist/css/",
    "test:run": "vitest run",
    "lint:ts": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@zvonok/client": "workspace:*",
    "@zvonok/video-layout": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^28.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io-client": "^4.8.3",
    "typescript": "~5.8.3",
    "vite": "^7.1.6",
    "vitest": "^4.0.18"
  }
}
