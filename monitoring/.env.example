# monitoring/.env - copied to ~/monitoring/.env on the VPS.
# Everything below is required by docker-compose.monitoring.yml.

# Grafana first login (grafana.yurifa.site)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Read-only metrics role created by monitoring/sql/monitoring-init.sql
POSTGRES_EXPORTER_USER=metrics_reader
POSTGRES_EXPORTER_PASSWORD=change-me

# GlitchTip database (created by monitoring/sql/monitoring-init.sql)
GLITCHTIP_DB_USER=glitchtip
GLITCHTIP_DB_PASSWORD=change-me
GLITCHTIP_DB_NAME=glitchtip
GLITCHTIP_SECRET_KEY=generate-with-openssl-rand-base64-32

# Name of the zvonok compose network (docker network ls) so GlitchTip can
# reach the postgres container by DNS.
ZVONOK_NETWORK=zvonok_default
