PORT=3000
DATABASE_URL="postgresql://username:password@localhost:5432/zvonok?schema=public"
CLIENT_URL=http://localhost:5173

POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=dbname

PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_GUEST_SECRET=change-me-guest
JWT_ACCESS_EXPIRES_IN_MINUTES=15
JWT_REFRESH_EXPIRES_IN_DAYS=7

# --- Developer platform ---
JWT_DEV_SECRET=change-me-dev
JWT_ROOM_SECRET=change-me-room
ROOM_TOKEN_TTL_MINUTES=60

MEDIASOUP_LISTEN_IP=127.0.0.1
# MEDIASOUP_ANNOUNCED_IP=  # Set to public IP in production
# RTC_MIN_PORT=40000
# RTC_MAX_PORT=40499

# --- TURN (optional, leave empty for STUN-only in dev) ---
# TURN_URL=turn:localhost:3478
# TURNS_URL=turns:localhost:5349
# TURN_AUTH_SECRET=  # prod: generate with `openssl rand -base64 32`; must match coturn's secret

# --- Error reporting (GlitchTip, Sentry-compatible; optional) ---
# Read before ConfigModule: set as a real environment variable in prod compose.
# SENTRY_DSN=http://key@errors.yurifa.site/1
