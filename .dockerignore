# Dependencies
node_modules
.pnpm-store

# Build outputs
apps/server/dist
apps/client/dist
apps/client/build
packages/*/dist

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# Test and coverage
coverage
.nyc_output
*.lcov

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment files (use docker env or secrets)
.env
.env.*
!.env.example

# Documentation
# docs/ must stay in the build context: it is the VitePress source for the
# docs image (Dockerfile.docs). Only its build output and cache are excluded.
docs/.vitepress/dist
docs/.vitepress/cache
*.md
!README.md

# Docker
docker-compose*.yml
Dockerfile*
.dockerignore

# Misc
.claude
scripts
LICENSE
